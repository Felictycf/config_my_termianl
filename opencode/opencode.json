{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "notionApi": {
      "command": [
        "/Users/felicity/.nvm/versions/node/v20.19.2/bin/notion-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "NOTION_TOKEN": "YOUR_NOTION_TOKEN_HERE"
      },
      "type": "local"
    },
    "pencil": {
      "command": [
        "/Users/felicity/.vscode/extensions/highagency.pencildev-0.6.30/out/mcp-server-darwin-arm64",
        "--app",
        "visual_studio_code"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "oh-my-opencode",
    "opencode-antigravity-auth@1.6.0",
    "opencode-openai-codex-auth",
    "oh-my-opencode@latest"
  ],
  "provider": {
    "glm": {
      "models": {
        "glm-4.7": {
          "name": "glm-4.7"
        }
      },
      "name": "GLM (OpenAI Compatible)",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://api.yyds168.net/v1"
      }
    },
    "google": {
      "models": {
        "antigravity-gemini-3-flash": {
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Gemini 3 Flash (Antigravity)"
        },
        "antigravity-gemini-3-pro-high": {
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Gemini 3 Pro High (Antigravity)"
        },
        "antigravity-gemini-3-pro-low": {
          "attachment": true,
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Gemini 3 Pro Low (Antigravity)"
        }
      },
      "name": "Google"
    },
    "minimax": {
      "models": {
        "minimax-m2.1": {
          "name": "minimax-m2.1"
        }
      },
      "name": "minmax_base",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.yyds168.net/v1"
      }
    },
    "openai": {
      "models": {
        "gpt-5.1-codex-max": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "GPT 5.1 Codex Max (OAuth)",
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.2": {
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "GPT 5.2 (OAuth)",
          "variants": {
            "high": {
              "reasoningEffort": "high",
